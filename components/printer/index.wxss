.devices_summary {
  display: flex;
  justify-content: space-between;
  flex-grow: 0;
  margin-top: 30px;
  padding: 0.75rem;
}

.text-link {
  color: hsl(210deg, 100%, 58%);
}

.px-3 {
  padding-left: 0.75rem;
  padding-right: 0.75rem;
}

.device_list {
  flex-grow: 1;
  margin-top: 0;
  margin-left: 0.75rem;
  margin-right: 0.75rem;
  width: auto;
  min-height: 6em;
  border: 1px solid #EEE;
  border-radius: 5px;
}

.device_item {
  display: flex;
  border-bottom: 1px solid #EEE;
  padding: 0.5em 0.75em;
  color: #666;
}

.device_item__inner {
  flex-grow: 1;
  display: flex;
  justify-content: space-between;
}

.device_item_hover {
  background-color: rgba(0, 0, 0, .1);
}

.weui-badge {
  color: gray;
  align-items: center;
  font-size: 0.8rem;
  border-radius: 4px;
  display: inline-flex;
  justify-content: center;
  line-height: 1.5;
  margin-left: 0.5rem;
  padding-left: 0.75em;
  padding-right: 0.75em;
  white-space: nowrap;
}

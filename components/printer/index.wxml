<view class="devices_summary">
  <text>已发现 {{devices.length}} 个设备：</text>
  <view bind:tap="restartBluetooth">重新搜索</view>
</view>
<scroll-view class="device_list" scroll-y scroll-with-animation>
  <view
    wx:for="{{devices}}"
    wx:key="index"
    data-device-id="{{item.deviceId}}"
    data-device-name="{{item.name || item.localName}}"
    class="device_item"
    hover-class="device_item_hover"
  >
    <view class="device_item__inner">
      <text>{{item.name}}</text>
      <text 
        wx:if="{{connectedId === item.deviceId && connected}}"
        bind:tap="closeBLEConnection"
        class="weui-badge"
      >已连接（点击断开）</text>
      <text
        wx:elif="{{connectedId === item.deviceId}}"
        class="weui-badge"
      >连接中</text>
      <text 
        wx:else
        bind:tap="createBLEConnection"
        class="weui-badge"
        style="background-color: darkgrey"
      >未连接（点击连接）</text>
    </view>
  </view>
</scroll-view>
